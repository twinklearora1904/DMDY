# DMDY Backend Server Environment Variables
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dmdy?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.com

# Initial Super Admin Credentials (Auto-seeded on start)
ADMIN_EMAIL=admin@dmdy.in
ADMIN_PASSWORD=change_this_secure_password

# Cloudinary (Media / Blog Cover Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Delivery Configuration (For Auto-Reply to Clients & Lead Alerts to Admin)
# ---------------------------------------------------------------------------------
# 1. Cloud / Render / Vercel Deployments (Recommended - uses HTTPS Port 443, no cloud port blocks):
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Local / Standard SMTP Fallback:
# GoDaddy (cPanel / Secureserver):
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@digimedigiyou.com
SMTP_PASS=your_godaddy_email_password
EMAIL_FROM="DMDY Digital" <info@digimedigiyou.com>
NOTIFICATION_RECEIVER_EMAIL=info@digimedigiyou.com

